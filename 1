      <span class="rating-mount"></span>
      <span class="remove" data-idx="${realIdx}" title="Удалить">×</span>
    `;
    const mount = row.querySelector('.rating-mount');
    const widget = document.createElement('div');
    widget.className = 'star-rating';
    widget.innerHTML = '<span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>';
    mount.appendChild(widget);
    initStarWidget(widget, p.rating, (val) => {
      p.rating = val;
      updateStats();
    });
    frag.appendChild(row);
  }
  playersSpacer.appendChild(frag);

  // Обработчик удаления через делегирование
  playersSpacer.onclick = (e) => {
