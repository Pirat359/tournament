// ==================== BRACKET GENERATION ====================
function generateBracket(mode = 'auto') {
  if (state.players.length < 2) {
    showStatus('Нужно минимум 2 участника', 'info');
    switchTab('players');
    return;
  }

  let size;
  if (state.bracketSize === 'auto') size = nextPowerOf2(state.players.length);
  else {
    size = parseInt(state.bracketSize);
    if (state.players.length > size) {
      showStatus(`Участников (${state.players.length}) больше, чем мест (${size}). Увеличьте размер.`, 'error');
      return;
    }
  }

  if (size > 4096) {
    showStatus(`Слишком большой размер сетки: ${size}. Максимум — 4096.`, 'error');
    return;
  }

  showStatus('Генерация сетки... Пожалуйста, подождите.', 'info', 2000);

  // Используем setTimeout чтобы дать UI обновиться
  setTimeout(() => {
    let orderedPlayers;
    if (mode === 'seeded') {
      orderedPlayers = [...state.players].sort((a, b) => b.rating - a.rating);
    } else if (mode === 'random') {
      orderedPlayers = shuffle(state.players);
    } else {
      orderedPlayers = [...state.players];
    }

    const seeded = seededOrder(orderedPlayers, size);
    const slots = [...seeded, ...Array(size - seeded.length).fill(null)];

    const rounds = [];
    const round1 = [];
    for (let i = 0; i < size; i += 2) {
      const p1 = slots[i];
      const p2 = slots[i + 1];
      let winner = null;
      if (p1 && !p2) winner = p1;
      else if (!p1 && p2) winner = p2;
      round1.push({ p1, p2, winner });
    }
    rounds.push(round1);

    let count = round1.length;
    while (count > 1) {
      const next = [];
      for (let i = 0; i < count / 2; i++) next.push({ p1: null, p2: null, winner: null });
      rounds.push(next);
      count = next.length;
    }

    // Автопроход bye
    for (let i = 0; i < round1.length; i++) {
      const m = round1[i];
      if (m.winner) {
        const nm = rounds[1][Math.floor(i / 2)];
        if (i % 2 === 0) nm.p1 = m.winner; else nm.p2 = m.winner;
      }
    }

    state.bracket = { rounds, size };
    state.champion = null;
    buildBracketIndex();
    renderBracketView();
    switchTab('bracket');
    showStatus(`Сетка на ${size} мест готова. Матчей: ${size - 1}.`, 'success');
    saveToStorage();
  }, 20);
}

function seededOrder(sorted, size) {
  if (sorted.length === 0) return [];
  const positions = new Array(size).fill(null);
  const seedArr = standardSeed(size);
  for (let i = 0; i < sorted.length; i++) {
    positions[seedArr[i] - 1] = sorted[i];
  }
  return positions;
}

function standardSeed(size) {
  let seeds = [1, 2];
  while (seeds.length < size) {
    const len = seeds.length;
    const ns = [];
    for (const s of seeds) { ns.push(s); ns.push(2 * len + 1 - s); }
    seeds = ns;
  }
  return seeds;
}

function buildBracketIndex() {
  bracketPlayerLocations.clear();
  if (!state.bracket) return;
  state.bracket.rounds.forEach((round, r) => {
    round.forEach((m, mi) => {
      if (m.p1) {
        if (!bracketPlayerLocations.has(m.p1.name)) bracketPlayerLocations.set(m.p1.name, []);
        bracketPlayerLocations.get(m.p1.name).push({ r, m: mi, slot: 'p1' });
      }
      if (m.p2) {
        if (!bracketPlayerLocations.has(m.p2.name)) bracketPlayerLocations.set(m.p2.name, []);
        bracketPlayerLocations.get(m.p2.name).push({ r, m: mi, slot: 'p2' });
      }
    });
  });
}

// ==================== BRACKET RENDER (виртуализация) ====================
const CARD_H = 54;    // базовая высота матча
const CARD_GAP = 6;   // базовый отступ

function computeLayout(size) {
  // Вычисляем высоту раунда и позиции матчей
  const totalH = Math.max(600, size * (CARD_H + CARD_GAP) * 0.5);
  return totalH;
}

function renderBracketView() {
  const viewport = document.getElementById('bracketViewport');
  const toolbar = document.getElementById('bracketToolbar');
  const empty = document.getElementById('bracketEmpty');
  const content = document.getElementById('bracketContent');
  const bracketEl = document.getElementById('bracketEl');

  if (!state.bracket) {
    viewport.style.display = 'none';
    toolbar.style.display = 'none';
    empty.style.display = 'block';
    return;
  }

  viewport.style.display = 'block';
  toolbar.style.display = 'flex';
  empty.style.display = 'none';

  const { rounds, size } = state.bracket;
  document.getElementById('bracketSizeInfo').textContent = size + ' мест';
  document.getElementById('matchCount').textContent = (size - 1);

  // Применяем масштаб
  content.style.transform = `scale(${state.zoom})`;

  // Выбираем класс компактности
  bracketEl.className = 'bracket';
  if (size >= 512) bracketEl.classList.add('ultra-compact');
  else if (size >= 128) bracketEl.classList.add('compact');

  // Если сетка огромная — используем "сжатую" высоту
  const effectiveCardH = size >= 512 ? 18 : (size >= 128 ? 24 : CARD_H);
  const effectiveGap = size >= 512 ? 1 : (size >= 128 ? 2 : CARD_GAP);

  // Общая высота первого раунда
  const round1H = (size / 2) * (effectiveCardH + effectiveGap);

  bracketEl.innerHTML = '';
  const roundNames = getRoundNames(rounds.length);

  rounds.forEach((round, rIdx) => {
    const roundDiv = document.createElement('div');
    roundDiv.className = 'round';
    roundDiv.style.minHeight = round1H + 'px';

    const title = document.createElement('div');
    title.className = 'round-title';
    title.textContent = roundNames[rIdx];
    roundDiv.appendChild(title);

    const count = document.createElement('div');
    count.className = 'round-count';
    count.textContent = `${round.length} матч${plural(round.length)}`;
    roundDiv.appendChild(count);

    round.forEach((m, mIdx) => {
      const mDiv = document.createElement('div');
      mDiv.className = 'match';
      mDiv.dataset.round = rIdx;
      mDiv.dataset.match = mIdx;

      mDiv.appendChild(createSlot(m.p1, m.winner && m.winner === m.p1, rIdx, mIdx, 'p1'));
      mDiv.appendChild(createSlot(m.p2, m.winner && m.winner === m.p2, rIdx, mIdx, 'p2'));

      roundDiv.appendChild(mDiv);
    });

    bracketEl.appendChild(roundDiv);
  });

  // Обработчик клика (делегирование)
  bracketEl.onclick = (e) => {
    const slot = e.target.closest('.match-slot');
    if (!slot) return;
    const r = +slot.dataset.round;
    const mi = +slot.dataset.match;
    const type = slot.dataset.slot;
    const match = state.bracket.rounds[r][mi];
    const player = type === 'p1' ? match.p1 : match.p2;
    if (!player || !match.p1 || !match.p2) return;
    advanceWinner(r, mi, player);
  };
}

function createSlot(player, isWinner, r, mi, slotType) {
  const div = document.createElement('div');
  div.className = 'match-slot';
  if (isWinner) div.classList.add('winner');
  if (!player) div.classList.add('empty');
  div.dataset.round = r;
  div.dataset.match = mi;
  div.dataset.slot = slotType;

  const nameSpan = document.createElement('span');
  nameSpan.className = 'slot-name';
  nameSpan.textContent = player ? player.name : '—';

  div.appendChild(nameSpan);

  // Звёзды только для маленьких сеток (оптимизация)
  if (player && state.bracket.size < 128) {
    const stars = document.createElement('div');
    stars.className = 'stars-mini';
    for (let i = 1; i <= 5; i++) {
      const s = document.createElement('span');
      s.className = 'star' + (i <= player.rating ? ' filled' : '');
      s.textContent = '★';
      stars.appendChild(s);
    }
    div.appendChild(stars);
  }

  return div;
}

function plural(n) {
  if (n % 10 === 1 && n % 100 !== 11) return '';
  if (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)) return 'а';
  return 'ей';
}

function getRoundNames(count) {
  const names = [];
  for (let i = 0; i < count; i++) {
    const rem = Math.pow(2, count - i);
    if (rem === 2) names.push('Финал');
    else if (rem === 4) names.push('1/2');
    else if (rem === 8) names.push('1/4');
    else if (rem === 16) names.push('1/8');
    else if (rem === 32) names.push('1/16');
    else if (rem === 64) names.push('1/32');
    else if (rem === 128) names.push('1/64');
    else if (rem === 256) names.push('1/128');
    else if (rem === 512) names.push('1/256');
    else if (rem === 1024) names.push('1/512');
    else names.push(`R${i + 1}`);
  }
  return names;
}

// ==================== ADVANCE WINNER ====================
function advanceWinner(roundIdx, matchIdx, winner) {
  const bracket = state.bracket;
  const match = bracket.rounds[roundIdx][matchIdx];
  match.winner = winner;

  // Обновляем следующий раунд
  if (roundIdx + 1 < bracket.rounds.length) {
    const nextMi = Math.floor(matchIdx / 2);
    const nextMatch = bracket.rounds[roundIdx + 1][nextMi];
    const slot = matchIdx % 2 === 0 ? 'p1' : 'p2';
    if (nextMatch[slot] !== winner) {
      nextMatch[slot] = winner;
      resetDownstream(roundIdx + 1, nextMi);
    }
  } else {
    state.champion = winner;
  }

  // Локально обновляем DOM вместо полного рендера
  updateMatchDOM(roundIdx, matchIdx);
  if (roundIdx + 1 < bracket.rounds.length) {
    updateMatchDOM(roundIdx + 1, Math.floor(matchIdx / 2));
    // Обновить дальше только если были изменения
    updateNextMatches(roundIdx + 1, Math.floor(matchIdx / 2));
  }
  if (state.champion) showChampion();
  saveToStorage();
}

function resetDownstream(roundIdx, matchIdx) {
  const bracket = state.bracket;
  const match = bracket.rounds[roundIdx][matchIdx];
  const oldWinner = match.winner;
  match.winner = null;
  if (roundIdx + 1 < bracket.rounds.length) {
    const nextMi = Math.floor(matchIdx / 2);
    const nextMatch = bracket.rounds[roundIdx + 1][nextMi];
    const slot = matchIdx % 2 === 0 ? 'p1' : 'p2';
    if (nextMatch[slot] && nextMatch[slot] === oldWinner) {
      nextMatch[slot] = null;
      resetDownstream(roundIdx + 1, nextMi);
    }
  } else {
    state.champion = null;
  }
}

function updateMatchDOM(r, mi) {
  const match = state.bracket.rounds[r][mi];
  const mDiv = document.querySelector(`.match[data-round="${r}"][data-match="${mi}"]`);
  if (!mDiv) return;
  const slots = mDiv.querySelectorAll('.match-slot');
  const p1Slot = slots[0];
  const p2Slot = slots[1];
  updateSlot(p1Slot, match.p1, match.winner && match.winner === match.p1);
  updateSlot(p2Slot, match.p2, match.winner && match.winner === match.p2);
}

function updateSlot(slot, player, isWinner) {
  slot.classList.toggle('winner', isWinner);
  slot.classList.toggle('empty', !player);
  const nameEl = slot.querySelector('.slot-name');
  nameEl.textContent = player ? player.name : '—';
  // Обновляем звёзды если есть
  const stars = slot.querySelector('.stars-mini');
  if (stars) {
    if (player) {
      stars.innerHTML = '';
      for (let i = 1; i <= 5; i++) {
        const s = document.createElement('span');
        s.className = 'star' + (i <= player.rating ? ' filled' : '');
        s.textContent = '★';
        stars.appendChild(s);
      }
    } else {
      stars.innerHTML = '';
    }
  }
}

function updateNextMatches(roundIdx, matchIdx) {
  // Проходим до финала, обновляя связанные матчи
  let r = roundIdx, mi = matchIdx;
  while (r + 1 < state.bracket.rounds.length) {
    const nextMi = Math.floor(mi / 2);
    updateMatchDOM(r + 1, nextMi);
    r = r + 1;
    mi = nextMi;
  }
  if (state.champion) showChampion();
}

function showChampion() {
  const banner = document.getElementById('winnerBanner');
  const nameEl = document.getElementById('championName');
  banner.classList.add('show');
  nameEl.innerHTML = `<span>${escapeHtml(state.champion.name)}</span>`;
  // Добавляем звёзды
  const stars = document.createElement('div');
  stars.className = 'star-rating readonly';
  for (let i = 1; i <= 5; i++) {
    const s = document.createElement('span');
    s.className = 'star' + (i <= state.champion.rating ? ' filled' : '');
    s.textContent = '★';
    stars.appendChild(s);
  }
  nameEl.appendChild(stars);
}

