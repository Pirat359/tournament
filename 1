  const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - 2);
  const endIdx = Math.min(total, Math.ceil((scrollTop + viewH) / ROW_HEIGHT) + 2);

  const frag = document.createDocumentFragment();
  for (let i = startIdx; i < endIdx; i++) {
    const p = filteredPlayers[i];
    const realIdx = state.players.indexOf(p); // для корректного удаления
    const row = document.createElement('div');
