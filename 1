  updatePlayerIndex();
  filterPlayers();
  generateBracket('random');
});

document.getElementById('resetBtn').addEventListener('click', () => {
  if (!confirm('Сбросить турнир полностью (участники + сетка)?')) return;
  state = { tournamentName: '', bracketSize: 'auto', renderMode: 'virtual', players: [], bracket: null, champion: null, zoom: 1 };
  playerIndex.clear();
  bracketPlayerLocations.clear();
  document.getElementById('tournamentName').value = '';
  document.getElementById('bracketSize').value = 'auto';
  filterPlayers();
  updateStats();
  renderBracketView();
  localStorage.removeItem('tournament_v3');
});

// ==================== INIT ====================
(function init() {
  const loaded = loadFromStorage();
  if (!loaded) {
    // Демо-данные
    const demo = [
      ['Иван', 5], ['Мария', 4], ['Алексей', 3], ['Ольга', 5],
      ['Дмитрий', 2], ['Анна', 4], ['Сергей', 3], ['Елена', 1]
    ];
    demo.forEach(([name, rating]) => {
      const p = { name, rating };
      state.players.push(p);
      playerIndex.set(name, p);
    });
  }
  updatePlayerIndex();
  filterPlayers();
  updateStats();
  if (state.bracket) {
    buildBracketIndex();
    renderBracketView();
    if (state.champion) showChampion();
  }
})();
</script>
</body>
</html>
