          if (locs.indexOf(loc) === 0) {
            mDiv.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
          }
        }
      });
      break; // только первое совпадение
    }
  }
});

// ==================== SAVE/LOAD ====================
function saveToStorage() {
  try {
    const data = {
      tournamentName: document.getElementById('tournamentName').value,
      bracketSize: document.getElementById('bracketSize').value,
      players: state.players,
      bracket: state.bracket,
      champion: state.champion
    };
    localStorage.setItem('tournament_v3', JSON.stringify(data));
  } catch (e) {
    // Молча игнорируем (например, при 10000+ команд может не хватить места)
    console.warn('Не удалось сохранить:', e);
  }
}

function loadFromStorage() {
  try {
    const raw = localStorage.getItem('tournament_v3');
    if (!raw) return false;
    const data = JSON.parse(raw);
    if (!data.players) return false;
    state.players = data.players;
    state.bracket = data.bracket;
    state.champion = data.champion;
    if (data.tournamentName) document.getElementById('tournamentName').value = data.tournamentName;
    if (data.bracketSize) document.getElementById('bracketSize').value = data.bracketSize;
    updatePlayerIndex();
    return true;
  } catch (e) {
    console.warn('Не удалось загрузить:', e);
    return false;
  }
}

